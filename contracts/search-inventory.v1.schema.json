{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinitrotorol.com/contracts/search-inventory.v1.schema.json",
  "title": "MHWILDS minimal search inventory snapshot v1",
  "description": "An ephemeral snapshot. Labels, stable profile IDs and timestamps must never enter a search request. Catalog/duplicate/appraisal checks are additionally required by the solver.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "catalog_revision", "decorations", "fixed_charms", "appraisal_charms"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decorations": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/decorationQuantity" } },
    "fixed_charms": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/fixedCharmQuantity" } },
    "appraisal_charms": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/appraisalCharm" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "quantity": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["kind", "level"],
      "properties": { "kind": { "enum": ["weapon", "armor"] }, "level": { "$ref": "#/$defs/positiveInteger" } }
    },
    "skillLevel": {
      "type": "object", "additionalProperties": false, "required": ["skill_id", "level"],
      "properties": { "skill_id": { "$ref": "#/$defs/id" }, "level": { "$ref": "#/$defs/positiveInteger" } }
    },
    "decorationQuantity": {
      "type": "object", "additionalProperties": false, "required": ["decoration_id", "quantity"],
      "properties": { "decoration_id": { "$ref": "#/$defs/id" }, "quantity": { "$ref": "#/$defs/quantity" } }
    },
    "fixedCharmQuantity": {
      "type": "object", "additionalProperties": false, "required": ["equipment_id", "quantity"],
      "properties": { "equipment_id": { "$ref": "#/$defs/id" }, "quantity": { "$ref": "#/$defs/quantity" } }
    },
    "appraisalCharm": {
      "type": "object", "additionalProperties": false,
      "required": ["instance_id", "rarity", "skills", "slots", "quantity"],
      "properties": {
        "instance_id": { "type": "string", "maxLength": 512, "pattern": "^owned:[0-9]+$" }, "rarity": { "$ref": "#/$defs/positiveInteger" },
        "skills": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/skillLevel" } },
        "slots": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/slot" } },
        "quantity": { "$ref": "#/$defs/quantity" }
      }
    }
  }
}
